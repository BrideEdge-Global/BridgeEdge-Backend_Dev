{
  "openapi": "3.0.0",
  "info": {
    "title": "BridgeEdge API",
    "version": "1.0.0",
    "description": "Enterprise backend API documentation"
  },
  "servers": [
    {
      "url": "https://bridgeedge-backend-dev.onrender.com",
      "description": ""
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Root Route",
        "responses": {
          "200": {
            "description": "Returns a basic welcome message"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register a new user",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "confirmPassword": { "type": "string" },
                  "isAdmin": { "type": "boolean", "default": false},
                  "isAgent": { "type": "boolean", "default": false},
                  "isCustomer": { "type": "boolean", "default": false},
                  "isActive": { "type": "boolean" }
                },
                "required": ["email", "password", "confirmPassword"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": { "type": "string" },
                    "password": { "type": "string" },
                    "confirmPassword": { "type": "string" },
                    "isAdmin": { "type": "boolean" },
                    "isAgent": { "type": "boolean" },
                    "isCustomer": { "type": "boolean" },
                    "isActive": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "409": {
            "description": "User already exists or password mismatch"
          }
        }
      }
    },
    "/api/auth/resend-otp": {
      "post": {
        "summary": "Resend OTP for verification",
        "tags": ["Auth"],
        "requestBody":{
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" }
                },
                "required": ["email", "otp"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "otp": { "type": "string" },
                    "otpExpires": { "type": "string", "format": "date-time" },
                    "otpToken": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/auth/admin-login": {
      "post": {
        "summary": "Login a user",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid login details"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/auth/verify-otp": {
      "post": {
        "summary": "Verify OTP for password reset",
        "tags": ["Auth"],
        "security": [
            { "bearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "otp": { "type": "string" }
                },
                "required": ["email", "otp"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP verified successfully"
          },
          "400": {
            "description": "Invalid OTP"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "summary": "Reset user password",
        "tags": ["Auth"],
        "security": [
            { "bearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "newPassword": { "type": "string" },
                  "confirmNewPassword": { "type": "string" }
                },
                "required": ["newPassword", "confirmNewPassword"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password has been changed successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": { "email": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or password mismatch"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/auth/change-password-logged-in-user": {
      "post": {
        "summary": "Reset user password while user is logged in",
        "tags": ["Auth"],
        "security": [
            { "bearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "CurrentPassword":{"type": "string"},
                  "newPassword": { "type": "string" },
                  "confirmNewPassword": { "type": "string" }
                },
                "required": ["email", "otp", "newPassword", "confirmNewPassword"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password has been changed successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": { "email": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or password mismatch"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    }
  }
}