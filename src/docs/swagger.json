{
  "openapi": "3.0.0",
  "info": {
    "title": "BridgeEdge API",
    "version": "1.0.0",
    "description": "Enterprise backend API documentation"
  },
  "servers": [
    {
      "url": "https://bridgeedge-backend-dev.onrender.com",
      "description": ""
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Root Route",
        "responses": {
          "200": {
            "description": "Returns a basic welcome message"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "confirmPassword": { "type": "string" },
                  "isAdmin": { "type": "boolean" },
                  "isAgent": { "type": "boolean" },
                  "isCustomer": { "type": "boolean" },
                  "isActive": { "type": "boolean" }
                },
                "required": ["email", "password", "confirmPassword"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": { "type": "string" },
                    "password": { "type": "string" },
                    "confirmPassword": { "type": "string" },
                    "isAdmin": { "type": "boolean" },
                    "isAgent": { "type": "boolean" },
                    "isCustomer": { "type": "boolean" },
                    "isActive": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "409": {
            "description": "User already exists or password mismatch"
          }
        }
      }
    },
    "/api/auth/resend-otp": {
      "post": {
        "summary": "Resend OTP for verification",
        "requestBody":{
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" }
                },
                "required": ["email", "otp"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent to your email"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/auth/admin-login": {
      "post": {
        "summary": "Login a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid login details"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/auth/verify-otp": {
      "post": {
        "summary": "Verify OTP for account confirmation",
        "description": "Verifies a user's OTP to confirm their email or account. If valid and not expired, the OTP is cleared and the user is marked as verified.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "user@example.com"
                  },
                  "otp": {
                    "type": "string",
                    "example": "123456"
                  }
                },
                "required": ["email", "otp"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP verified successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "OTP verified successfully"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - missing fields, invalid or expired OTP"
          },
          "404": {
            "description": "User not found or OTP record missing"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/auth/send-otp-for-password-changing": {
      "post": {
        "summary": "Send OTP for changing password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" }
                },
                "required": ["email"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent to your email"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "summary": "Change user password",
        "description": "Allows a user to change their password by providing their email, new password, and confirming the new password. The OTP field is not required or used in this endpoint.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { 
                    "type": "string", 
                    "example": "user@example.com"
                  },
                  "newPassword": { 
                    "type": "string", 
                    "example": "NewPassw0rd!" 
                  },
                  "confirmNewPassword": { 
                    "type": "string", 
                    "example": "NewPassw0rd!" 
                  }
                },
                "required": ["email", "newPassword", "confirmNewPassword"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { 
                      "type": "string", 
                      "example": "Password reset successfully" 
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - e.g., missing fields, password mismatch, or weak password"
          },
          "404": {
            "description": "User not found or OTP expired"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },    

    "/api/auth/change-password-logged-in-user": {
      "post": {
        "summary": "Reset user password while user is logged in",
        "security": [
            { "bearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "CurrentPassword":{"type": "string"},
                  "newPassword": { "type": "string" },
                  "confirmNewPassword": { "type": "string" }
                },
                "required": ["email", "otp", "newPassword", "confirmNewPassword"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password has been changed successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": { "email": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or password mismatch"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    }
  }
}
